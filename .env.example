# Requerido: tu API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional en desarrollo local: si no están seteadas, la app guarda
# el progreso de la sesión en un archivo local (./.data) en vez de Vercel KV.
# En producción (Vercel), conecta un KV Store y estas se llenan solas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
